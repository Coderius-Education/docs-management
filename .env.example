# Kopieer naar `stack.env` (Portainer) of `.env` (lokaal) en vul in.

# --- Algemeen ---
ENVIRONMENT=production
ADMIN_DOMAIN=beheer.coderius.nl
PREVIEW_DOMAIN_SUFFIX=preview.coderius.nl
# Naam van het bestaande externe Traefik-netwerk op de VPS
TRAEFIK_NETWORK=traefik

# --- Wildcard preview-cert (DNS-01) ---
# LET OP: deze credential hoort op de EXTERNE Traefik-container, niet op deze
# stack (deze services lezen 'm niet). Hetzner DNS Console API-token voor de
# `lednsresolver` certresolver. Zie README §Hetzner DNS-01.
# HETZNER_API_KEY=

# --- Database ---
# Kies een sterk wachtwoord en vul het op BEIDE plekken in (env_file ondersteunt geen $-interpolatie).
POSTGRES_PASSWORD=verander-mij
DATABASE_URL=postgresql+asyncpg://docsmgmt:verander-mij@db:5432/docsmgmt

# --- GitHub OAuth App (org-owned; callback: https://$ADMIN_DOMAIN/api/auth/callback) ---
# Let op: voor "Nieuwe site" heeft het gebruikers-token schrijfrechten nodig op
# ZOWEL Coderius-Education/docs ALS Coderius-Education/docs-management.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Repo met deze beheer-app zelf (voor de tweede PR die een site registreert).
GITHUB_MANAGEMENT_REPO=docs-management

# --- GitHub webhook (repo Coderius-Education/docs -> https://$ADMIN_DOMAIN/api/webhooks/github) ---
GITHUB_WEBHOOK_SECRET=

# --- Fine-grained PAT, alleen-lezen op Coderius-Education/docs ---
# Permissions: Actions (read), Contents (read), Pull requests (read), Metadata (read)
GITHUB_SERVER_TOKEN=

# --- Sessies/tokens ---
# Genereer met: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SECURE_COOKIES=true

# --- Delivery ---
BUILDS_DIR=/data/builds
BUILDS_KEEP_PER_BRANCH=3
