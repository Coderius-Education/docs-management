+export function Picture({src,alt,caption,...props}: Common & {src:string;alt:string;caption?:string}) {const url=useBaseUrl(src);return <figure className={classes(props)}><img src={url} alt={alt} loading="lazy"/>{caption && <figcaption>{caption}</figcaption>}</figure>;}
